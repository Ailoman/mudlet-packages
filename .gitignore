# Built packages (but dist/ is CI-generated output Ailo Updater serves to
# Mudlet clients over raw.githubusercontent.com, and archive/ is the
# permanent per-version backup used for rollbacks -- both are tracked)
*.mpackage
*.zip
!dist/*.mpackage
!archive/**/*.mpackage

# Mudlet runtime data
*.map.dat
*.idmap.lua
*.settings.lua
*.nicks.lua
*.links.lua
*.danger.lua
*.packages.json

# OS
.DS_Store
Thumbs.db
desktop.ini
